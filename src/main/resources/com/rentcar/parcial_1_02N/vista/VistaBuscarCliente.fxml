<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:id="contenedorPrincipal"
      fx:controller="com.rentcar.parcial_1_02N.controlador.ControladorBuscarCliente"
      spacing="10" alignment="CENTER" prefWidth="600" prefHeight="400">

    <Label text="Buscar Cliente" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <TextField fx:id="txtTelefono" promptText="Teléfono del cliente"/>

    <Button text="Buscar" onAction="#buscarCliente"/>

    <Button text="Volver" onAction="#volverGestionClientes"/>

</VBox>