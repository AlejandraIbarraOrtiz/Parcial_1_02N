<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rentcar.parcial_1_02N.controlador.ControladorMenuPrincipal"
      spacing="15" alignment="CENTER">

    <Label text="Sistema RentCar"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Button text="Gestión de Clientes" onAction="#abrirGestionClientes"/>
    <Button text="Gestión de Vehículos" onAction="#abrirGestionVehiculos"/>
    <Button text="Gestión de alquileres" onAction="#abrirGestionAlquileres"/>
    <Button text="Reservas" onAction="#abrirReservas"/>
    <Button text="Servicios Adicionales" onAction="#abrirServicios"/>

</VBox>
